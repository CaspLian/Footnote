{
  "name": "unfold-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test src/domain/*.test.ts src/store/*.test.ts src/native/*.test.ts",
    "doctor": "npx expo-doctor",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "web": "expo start --web",
    "bundle:web": "expo export --platform web --output-dir dist/web"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "14.0.2",
    "@config-plugins/react-native-pdf": "14.0.2",
    "@expo-google-fonts/geist": "0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "57.0.27",
    "expo-asset": "~57.0.19",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "phosphor-react-native": "3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "0.25.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pdf": "7.0.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
