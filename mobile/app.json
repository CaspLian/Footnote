{
  "expo": {
    "name": "Footnote",
    "slug": "footnote",
    "version": "0.1.0",
    "scheme": "footnote",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.hackknights.unfold",
      "supportsTablet": false,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "icon": {
        "light": "../brand/png/appicon/footnote-appicon-light-1024.png",
        "dark": "../brand/png/appicon/footnote-appicon-dark-1024.png"
      }
    },
    "android": {
      "package": "org.hackknights.unfold",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Footnote to use the camera."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Footnote to select a bill or EOB from your photos.",
          "cameraPermission": "Allow Footnote to photograph your bill or EOB."
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your private Footnote workspace."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Footnote to use the microphone so you can talk through your bill with the voice helper."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow Footnote to use the microphone so you can talk through your bill with the voice helper.",
          "cameraPermission": "Allow Footnote to photograph your bill or EOB."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Footnote"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4690d017-8cb2-47b9-9e3d-856aae34bcd4"
      }
    },
    "icon": "./assets/icon.png"
  }
}
