{
  "expo": {
    "name": "Unfold",
    "slug": "unfold",
    "version": "0.1.0",
    "scheme": "unfold",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.hackknights.unfold",
      "supportsTablet": false,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "org.hackknights.unfold",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Unfold to select a bill or EOB from your photos.",
          "cameraPermission": "Allow Unfold to photograph your bill or EOB.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your private Unfold workspace."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Unfold"
    }
  }
}
