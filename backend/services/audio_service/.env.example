# Settings for backend/services/audio_service. This file holds NO real values.
# Copy the lines you need into backend/.env, the backend's shared settings file, and fill in
# your own values. The repo's .gitignore keeps backend/.env out of git: never commit it, and
# never paste the key into chat or code. ElevenLabs disables keys pushed to a public GitHub repo.
# Format: one NAME=value per line, no quotes. Put comments on their own line, like these ones.

# --- Required ---------------------------------------------------------------

# Create a key at https://elevenlabs.io/app/developers (API Keys tab).
# Permissions to enable: Text to Speech, Speech to Text, Voices (Read), User (Read).
# Tip: also set a credit limit on the key, so a bug cannot spend your whole quota.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# --- Optional (defaults shown) ------------------------------------------------

# The voices users can choose are listed in text_to_speech/voices.json (20 for now; the default
# is Matilda). Run `python -m text_to_speech.check_setup` (from backend/services/audio_service)
# to check they work on your account. Set this only to replace the default voice's ID.
ELEVENLABS_VOICE_ID=

# Measured 2026-10-09, a 222-character bill text (README, "Speed"):
# eleven_multilingual_v2: stable, reads numbers well, supports speed; slowest (first audio 3.6 s) (default)
# eleven_flash_v2_5: fastest and half the credits (first audio 1.0 s, all of it 1.8 s); numbers are
#   read right because the module turns ElevenLabs' number reading on for it (see below)
# eleven_v4: newest quality model (launched 2026-09-28); no speed setting; slow to finish (6.7 s)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# How ElevenLabs reads numbers, money and dates: auto, on or off. Leave empty for the module's
# choice: "on" for Flash (which misread "$12,345.67" and "E11.9" with "auto" in our test), "auto"
# (ElevenLabs' default) for the others. "on" adds a little time.
ELEVENLABS_TEXT_NORMALIZATION=

# MP3 at 128 kbps works on every plan and plays on every phone and browser.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# 0.7 (slower) to 1.2 (faster). Leave empty to use the voice's own speed.
# Not available on eleven_v3 or eleven_v4.
ELEVENLABS_SPEED=

# Longest cleaned-up text we send. Every character, including spaces, is billed.
TTS_MAX_CHARS=2500

# Seconds to wait for ElevenLabs on each attempt. Measured: 873 characters took 13.9 s with
# eleven_multilingual_v2, so 2,500 characters can take about 40 s.
TTS_TIMEOUT_SECONDS=60

# Extra attempts after a temporary failure (0 to 3). A timed-out attempt may still be
# finished and billed by ElevenLabs, so keep this low.
TTS_MAX_RETRIES=1

# Folder for generated audio, reused across restarts. A relative path is inside audio_service
# (git-ignored there). Leave empty to keep audio in memory only.
TTS_CACHE_DIR=.tts_cache

# --- Speech-to-text (optional, defaults shown) ----------------------------------
# Uses the same ELEVENLABS_API_KEY.

# scribe_v2: current model, $0.22 per hour of audio.
# scribe_v2_medical: same price and API, tuned for clinical audio.
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Largest recording accepted. The app's HIGH_QUALITY preset records about 1 MB per minute.
STT_MAX_AUDIO_MB=10

# Seconds to wait for a transcript (63 s of audio took 4.6 s in testing).
STT_TIMEOUT_SECONDS=60

# Extra attempts after a temporary failure (0 to 3).
STT_MAX_RETRIES=1
