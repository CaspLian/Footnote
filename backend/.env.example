# Copy this file to .env and fill in your keys. Never commit .env.

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# true = return fake data without calling Gemini
MOCK=false
# Optional speed settings (docs/decisions/2026-10-11-gemini-low-thinking.md). Defaults shown.
# Thinking level for Gemini 3 models: minimal, low, medium, high, or default (the model's own). low is 3-5x faster
# than the model's default with the same extraction on the benchmark documents.
GEMINI_THINKING_LEVEL=low
# Image detail: low, medium or high; empty = the model's default
GEMINI_MEDIA_RESOLUTION=
# Seconds per Gemini attempt (six phone photos took about 34 s)
GEMINI_ATTEMPT_TIMEOUT_S=60

# ElevenLabs
ELEVENLABS_API_KEY=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=PUBLIC
# snowflake (default) or csv to skip Snowflake and use data/cpt_benchmarks.csv
PRICE_SOURCE=snowflake
# Load the Snowflake price table at startup, so the first bill does not wait about 11 s for Snowflake to wake up
PRICE_WARM_UP=true

# Tiger Data
TIGER_DATA_POSTGRES_URL=postgresql://user:password@host:port/dbname?sslmode=require
